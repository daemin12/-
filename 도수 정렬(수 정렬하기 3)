#define _CRT_SECURE_NO_WARNINGS
#include <stdio.h>
#include <stdlib.h>

int main(void)
{
	int testcase = 0;
	int n = 0;

	int count[10001] = { 0, };

	scanf("%d", &testcase);

	for (int i = 0; i < testcase; i++)
	{
		scanf("%d", &n);

		count[n] += 1;
	}

	for (int i = 1; i < 10001; i++)
	{
		while (count[i] > 0)
		{
			printf("%d\n", i);
			count[i] -= 1;
		}
	}
	
	return 0;
}


