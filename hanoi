#include <stdio.h>
#include <math.h>

void hanoi_method(int hanoi, int from, int tmp, int to);


int main()
{
	int hanoi = 0;
	int min[1000] = { 0, };
	int len = 1;

	scanf("%d", &hanoi);

	min[0] = 1;

	for (int i = 0; i < hanoi; i++)//원반 횟수 만큼 2곱하기
	{
		for (int j = 0; j < len; j++) //각 자릿수를 2씩 곱함
			min[j] *= 2;
		
		for (int k = 0; k < len; k++)
		{
			if (min[k] >= 10)  // 만약에 10보다 크면
			{
				if (k == len - 1) // 가장 마지막 수라면 길이를 늘림
					len++;

				min[k + 1] += 1; // 다음 자리 숫자를 +1함

				min[k] %= 10; //10의 나머지로 바꿔줌
			}
		}
	}

	min[0] -= 1;
	
	for (int i = len - 1; i >= 0; i--)
		printf("%d", min[i]);

	printf("\n");

	if(hanoi <= 20)
	hanoi_method(hanoi, 1, 2, 3);

	return 0;
}

void hanoi_method(int hanoi, int from, int tmp, int to)
{
	if (hanoi == 1)
	{
		printf("%d %d\n", from, to);
		return;
	}

		hanoi_method(hanoi - 1, from, to, tmp);
		printf("%d %d\n", from, to);
		hanoi_method(hanoi - 1, tmp, from, to);
}
