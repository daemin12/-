#include <stdio.h>
#define length 10
int main()
{
	int paper[100][100] = { 0, };
	int n = 0, horizontal = 0 , vertical = 0, sum = 0;
	int j = 0, k = 0;

	scanf("%d", &n);

	for (int i = 0; i < n; i++)
	{

		scanf("%d %d", &horizontal, &vertical);
		{
			for (int j = horizontal - 1; j < (horizontal + 9); j++)
			{
				for (int k = vertical - 1; k < (vertical + 9); k++)
				{
					paper[j][k] = 1;
				}
			}
		}
	}

	for (int i = 0; i < 100; i++)
	{
		for (int j = 0; j < 100; j++)
		{
			if (paper[i][j] == 1)
				sum += 1;
		}
	}
	
	printf("%d", sum);

	return 0;
}
