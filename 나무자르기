#define _CRT_SECURE_NO_WARNINGS
#include <stdio.h>
#include <stdlib.h>

int tree;
int* arr;
int length = 0;
int max = 0;
void high(int left, int right);

int main()
{
	scanf("%d %d", &tree, &length);
    
	arr = (int*)malloc(sizeof(int) * tree);

	for (int i = 0; i < tree; i++)
		scanf("%d", &arr[i]);
	 
	int right = 0; //최댓값

	for (int i = 0; i < tree; i++)
		if (right < arr[i])
			right = arr[i];

	high(0, right);

	printf("%d", max);

	free(arr);

	return 0;
}
void high(int left, int right)
{

	while (left <= right)
	{
		int middle = (left + right) / 2;

		long long sum = 0; //합을 0으로 설정

		for (int i = 0; i < tree; i++)
			if (arr[i] - middle > 0)
				sum += (arr[i] - middle); // 자르고 남은 나무를 더함

		if (sum >= length)
		{
			max = middle;
			left = middle + 1;
	   }

		else if (sum < length)
			right = middle - 1;
		
         
	}
}
